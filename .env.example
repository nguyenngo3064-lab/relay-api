# HUAN RELAY - example environment configuration (placeholders only)
# Copy to .env and fill in real values. NEVER commit .env.
# Provider API keys are NOT set here; enter them in the admin dashboard.

# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=8080

# SQLite database file. In production put it OUTSIDE the repo (e.g. /var/lib/huan-relay/relay.db)
# and back it up regularly + checkpoint WAL on shutdown.
DATABASE_PATH=./data/huan-relay.db

# Application secrets (generate your own; do NOT reuse these examples).
# Values starting with "replace-with" are rejected at startup.
# Session signing secret (min 32 chars)
SESSION_SECRET=replace-with-a-long-random-string-min-32-chars

# 32-byte hex key (64 hex chars) used to AES-256-GCM encrypt provider keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_ENCRYPTION_KEY=replace-with-64-hex-chars-0000000000000000000000000000000000

# Optional global pepper for client relay-key hashing (recommended, min 16 chars)
RELAY_KEY_PEPPER=replace-with-a-random-pepper

# Set to "true" ONLY if HUAN RELAY runs behind a trusted reverse proxy that
# terminates TLS and sets X-Forwarded-* headers. Enables Secure cookies + HSTS.
TRUSTED_PROXY_CONFIG=false

# Public base URL shown in the dashboard (fixes 0.0.0.0/127.0.0.1 behind proxy).
# Example: PUBLIC_URL=https://relay.example.com
# PUBLIC_URL=

# Optional first-run admin bootstrap. ONLY used to create the initial admin
# account when none exists yet (first run). Never a default credential; never
# logged. Recommend removing it after first login. Min 12 characters.
# Prefer creating the admin via the dashboard, or set ADMIN_PASSWORD_HASH.
# ADMIN_BOOTSTRAP_PASSWORD=

# Optional setup token required for /api/auth/setup when set.
# In production, set one of ADMIN_BOOTSTRAP_PASSWORD, ADMIN_PASSWORD_HASH, or ADMIN_SETUP_TOKEN.
# ADMIN_SETUP_TOKEN=

# Resource / safety limits (optional overrides)
# MAX_REQUEST_BODY_BYTES=1048576
# MAX_RESPONSE_BYTES=4194304
# PROVIDER_REQUEST_TIMEOUT_MS=60000
# PROVIDER_CONNECT_TIMEOUT_MS=10000
# MAX_CONCURRENT_REQUESTS=8
# LOGIN_RATE_PER_MINUTE=5
# TEST_RATE_PER_MINUTE=6
# CONTEXT_PROCESSING_TIMEOUT_MS=5000
# MAX_CONTEXT_TOKENS=120000
# RELAY_MAX_BODY_BYTES=8388608
# RETENTION_DAYS=30
